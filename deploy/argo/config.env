# KEY=VALUE. 환경변수 전부 여기 둔다 — k8s Secret 미사용(가이드 §5 정책). 바뀌면 configMapGenerator 해시가 바뀌어 자동 롤아웃.
# ★ env 파일은 줄 끝 주석을 값으로 읽으므로 주석은 반드시 별도 줄에.

APP_LOG_LEVEL=INFO

# ===== FHIR 데이터 소스 =====
# 같은 ns 의 snuh-fhir-web Service (airgap/snuh-fhir-web deploy/service.yaml). 내부 호출이라 app-gateway 를 거치지 않고,
# FHIR 리소스 호출 자격은 사용자 PAT(Authorization: Bearer) 로 snuh-fhir-web 이 직접 검증한다.
# ★ 테스트 서버는 당분간 mock — 이미지에 든 가상 환자 2명(10000001, 20000002)으로 동작하며 snuh-fhir-web·PAT 가 필요 없다.
#   실 FHIR 로 전환할 때 http 로 바꾸고 아래 APP_FHIR_TOKEN 을 채운다.
APP_FHIR_MODE=mock
APP_FHIR_BASE_URL=http://snuh-fhir-web.platform.svc.cluster.local:8000
APP_FHIR_TIMEOUT_SECONDS=30
# 서비스 계정 PAT — snuh-fhir-web 관리자가 서비스용 계정으로 「내 토큰」에서 발급(최대 365일)하고 그 계정에 FHIR 접근 허용을 부여한 값.
# 모든 사용자가 이 토큰 하나로 FHIR 를 조회한다 (snuh-fhir 감사 로그에는 이 계정이 남는다). 만료 전 교체 → config.env 갱신 → Sync.
# 비워 두면 화면에 PAT 등록 패널이 떠 사용자 본인 토큰으로 동작한다. ★ 값에 따옴표·줄 끝 주석 금지.
APP_FHIR_TOKEN=

# ===== 조회 범위 (일) =====
APP_LAB_LOOKBACK_DAYS=180
APP_VITAL_LOOKBACK_DAYS=30
APP_ECG_LOOKBACK_DAYS=365
APP_WEIGHT_HISTORY_DAYS=100
APP_STALE_AFTER_DAYS=7

# ===== 배포 경로 =====
# 프록시 env slug 와 반드시 일치 (URL /apps/runtime/snuh-patient-calculator/). 앱이 prefix 를 스스로 수용하므로 프록시는 경로를 고치지 않는다.
APP_PATH_PREFIX=/apps/runtime/snuh-patient-calculator
