# SNUH Patient Calculator — Environment Variables
# Copy this file to .env and customize. Never commit .env with real secrets.
#
# 저장소 루트의 .env 는 백엔드가 기동 시 자동으로 읽는다 (셸 환경변수가 우선, docker compose 는 env_file).
# 로컬 개발·시연은 APP_FHIR_MODE=mock 한 줄이면 충분하다.

# ===== Logging =====
APP_LOG_LEVEL=INFO

# ===== FHIR 데이터 소스 =====
# http = snuh-fhir 호출 (운영) / mock = backend/fixtures 의 번들 (개발·시연)
APP_FHIR_MODE=http
# snuh-fhir 기본 URL. gateway 경유: https://<host>/apps/runtime/fhir, 클러스터 내부: http://snuh-fhir:8000
APP_FHIR_BASE_URL=http://localhost:8000
# 서비스 계정 개인 액세스 토큰(PAT). snuh-fhir 「내 토큰」에서 발급 + 관리자가 FHIR 접근 허용 부여.
# 요청에 X-Fhir-Token 헤더가 있으면 그 토큰이 우선한다. 값은 로그에 남지 않는다.
#APP_FHIR_TOKEN=snuhfhir_xxxxxxxx_...
APP_FHIR_TIMEOUT_SECONDS=30
# mock 모드 fixture 디렉터리 (patients/{환자번호}.json)
#APP_FIXTURES_DIR=/app/backend/fixtures

# ===== 조회 범위 (일) — 「가장 최근 값」을 찾기 위해 뒤로 훑는 기간. 길수록 snuh-fhir·ODS 부하 증가 =====
APP_LAB_LOOKBACK_DAYS=180
APP_VITAL_LOOKBACK_DAYS=30
APP_ECG_LOOKBACK_DAYS=365
# 체중 이력 (NRS-2002 체중감소율) — 활력징후보다 길게
APP_WEIGHT_HISTORY_DAYS=100
# 심전도 exam 검색의 code(처방명 LIKE)
APP_ECG_ORDER_NAME=심전도
# 페이지 크기(≤1000)·리소스별 최대 페이지 수 — 환자 1명 조회 비용 상한
APP_PAGE_SIZE=1000
APP_MAX_PAGES=3
# 자동 채움값이 이보다 오래되면 화면에 「오래됨」 표시
APP_STALE_AFTER_DAYS=7

# ===== 항목명 → 변수 매핑 덮어쓰기 (YAML) =====
# 운영 ODS 의 검사항목명·간호어휘명이 내장 별칭과 다를 때. 형식은 README 참고.
#APP_VARIABLE_MAP_PATH=/app/config/variables.yaml

# ===== 배포 =====
# 외부 공개 경로 prefix (gateway 가 strip 하든 안 하든 동작). 미설정 = prefix 없음.
#APP_PATH_PREFIX=/apps/runtime/calculator
# 빌드된 프런트 경로. 기본 = backend 기준 ../frontend/dist
#APP_UI_DIST_DIR=/app/frontend/dist
# 컨테이너 포트 매핑 (compose)
API_PORT=8010
